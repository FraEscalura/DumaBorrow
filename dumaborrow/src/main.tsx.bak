import React,{useEffect,useState} from 'react';import{createRoot}from'react-dom/client';import{BrowserRouter,Link,NavLink,useNavigate,useParams,useSearchParams}from'react-router-dom';import{Routes,Route}from'react-router-dom';import{Search,ArrowUpRight,ArrowRight,Menu,X,ShieldCheck,MapPin,CalendarDays,Package,Camera,BookOpen,ChevronDown}from'lucide-react';import{db,configured}from'./client';import{categories,demos,Item,peso,photos}from'./data';import './style.css';
const feeRate=.08;const dayCount=(a:string,b:string)=>Math.max(0,Math.round((Date.parse(b+'T00:00:00Z')-Date.parse(a+'T00:00:00Z'))/86400000)+1);const today=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Manila',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
function App(){const[session,setSession]=useState<any>(null),[items,setItems]=useState<Item[]>([]),[loading,setLoading]=useState(true),[menu,setMenu]=useState(false);const nav=useNavigate();async function refresh(){if(!db){setLoading(false);return}const{data,error}=await db.from('items').select('*').eq('status','published').order('created_at',{ascending:false});if(!error)setItems(data||[]);setLoading(false)}useEffect(()=>{refresh();db?.auth.getSession().then(({data})=>setSession(data.session));const{data:listener}=db?.auth.onAuthStateChange((_e,s)=>setSession(s))||{};return()=>listener?.subscription.unsubscribe()},[]);const user=session?.user;const logout=async()=>{await db?.auth.signOut();nav('/')};const card=(item:Item)=><Link to={'/item/'+item.id} className="item-card" key={item.id}><div className="item-image"><img src={item.image_url} alt={item.title} loading="lazy"/><span className="image-label">{item.demo?'SAMPLE LISTING':item.condition}</span></div><div className="item-content"><div className="item-meta"><span>{item.category}</span><span><MapPin size={13}/>{item.location}</span></div><h3>{item.title}</h3><div className="item-bottom"><span><strong>{peso(item.price)}</strong> / day</span><ArrowUpRight size={19}/></div></div></Link>;
function Home(){const[q,setQ]=useState('');return <><section className="hero container"><div className="hero-copy"><p className="eyebrow"><span className="dot"/> MADE FOR THE WAY DUMAGUETE LIVES</p><h1>Borrow more.<br/><em>Spend less.</em></h1><p className="hero-description">Need a calculator for exams, a camera for the weekend, or a projector for your next presentation? Find what you need nearby without paying the full price.</p><div className="hero-actions"><Link className="btn primary" to="/explore">Explore rentals <ArrowUpRight size={17}/></Link><Link className="btn secondary" to="/list">List your item <ArrowRight size={17}/></Link></div><div className="hero-search"><Search size={20}/><input aria-label="Search rentals" placeholder="What do you need to borrow?" value={q} onChange={e=>setQ(e.target.value)} onKeyDown={e=>e.key==='Enter'&&nav('/explore?q='+encodeURIComponent(q))}/><button aria-label="Search" onClick={()=>nav('/explore?q='+encodeURIComponent(q))}><ArrowRight size={19}/></button></div><p className="quiet">The things you need, from people nearby.</p></div><div className="hero-visual"><div className="hero-photo photo-main"><img src={photos.camera} alt="Camera available as a type of rental item"/></div><div className="hero-photo photo-small"><img src={photos.books} alt="Stack of books"/></div><div className="floating-note"><span>GOOD THINGS ARE MEANT TO BE SHARED</span><strong>Make room for more, with less.</strong></div><div className="visual-circle"/></div></section><section className="section container"><div className="section-top"><div><p className="eyebrow">FIND YOUR THING</p><h2>What are you looking for?</h2></div><Link className="text-link" to="/explore">Browse everything <ArrowUpRight size={17}/></Link></div><div className="category-grid">{categories.map((c,i)=><Link to={'/explore?category='+encodeURIComponent(c)} className="category" key={c}><span className="category-index">0{i+1}</span><strong>{c}</strong><ArrowUpRight size={19}/></Link>)}</div></section><section className="section tinted"><div className="container"><div className="section-top"><div><p className="eyebrow">TAKE A LOOK AROUND</p><h2>Useful things, closer than you think.</h2><p className="section-sub">A preview of what DumaBorrow can look like. Items below are examples, not live rental offers.</p></div><Link className="text-link" to="/explore">See all items <ArrowUpRight size={17}/></Link></div><div className="items-grid">{[...items.slice(0,4),...demos].slice(0,4).map(card)}</div></div></section><section className="section container"><p className="eyebrow">THREE SIMPLE STEPS</p><div className="section-top"><h2>Find it. Request it. Return it.</h2></div><div className="steps">{[['01','Find what you need','Browse items by category, price, or pickup area.'],['02','Send a request','Choose your dates and ask the owner. Nothing is booked until they accept.'],['03','Meet and return','Agree on payment and a safe public pickup spot. Return the item on time.']].map(([n,h,p])=><div className="step" key={n}><span>{n}</span><h3>{h}</h3><p>{p}</p></div>)}</div></section><section className="owner-band"><div className="container owner-layout"><div><p className="eyebrow">HAVE SOMETHING TO SHARE?</p><h2>Your unused stuff could be someone else's next big help.</h2><p>Set your price, choose your available dates, and decide which requests to accept.</p><Link to="/list" className="btn light">List an item for free <ArrowUpRight size={18}/></Link></div><div className="owner-graphic"><Package size={100} strokeWidth={1}/><span>LESS CLUTTER.<br/>MORE POSSIBILITIES.</span></div></div></section><section className="section container trust"><div><p className="eyebrow">A LITTLE CARE GOES A LONG WAY</p><h2>Borrow with clarity.<br/>Share with confidence.</h2></div><div className="trust-grid"><div><ShieldCheck/><h3>Know what you're getting</h3><p>Owners can provide item photos, condition details, deposits, and rental terms before you request.</p></div><div><CalendarDays/><h3>Requests, not surprises</h3><p>Owners review requests before confirming. Accepted bookings cannot overlap for the same item.</p></div><div><MapPin/><h3>Meet thoughtfully</h3><p>Choose a public, well-lit meetup location. Inspect items together and keep a written record of agreements.</p></div></div></section><section className="section tinted"><div className="container faq-layout"><div><p className="eyebrow">GOOD TO KNOW</p><h2>Questions, answered.</h2><Link className="text-link" to="/faq">More answers <ArrowUpRight size={17}/></Link></div><div>{faqs.slice(0,4).map(([q,a])=><details key={q}><summary>{q}<ChevronDown size={18}/></summary><p>{a}</p></details>)}</div></div></section></>}
function Explore(){const[params,setParams]=useSearchParams();const q=params.get('q')||'',cat=params.get('category')||'',loc=params.get('location')||'',max=params.get('max')||'';const set=(k:string,v:string)=>{const p=new URLSearchParams(params);v?p.set(k,v):p.delete(k);setParams(p)};const shown=[...items,...demos].filter(i=>(!q||(i.title+' '+i.description).toLowerCase().includes(q.toLowerCase()))&&(!cat||i.category===cat)&&(!loc||i.location.toLowerCase().includes(loc.toLowerCase()))&&(!max||i.price<=Number(max)));return <main className="container page"><p className="eyebrow">EXPLORE DUMABORROW</p><h1>Find something useful.</h1><p className="muted">Discover sample ideas and listings published by real members. Sample items cannot be booked.</p><div className="filters"><label>Search<input value={q} onChange={e=>set('q',e.target.value)} placeholder="Search items"/></label><label>Category<select value={cat} onChange={e=>set('category',e.target.value)}><option value="">All categories</option>{categories.map(c=><option key={c}>{c}</option>)}</select></label><label>Maximum daily price<input type="number" min="0" value={max} onChange={e=>set('max',e.target.value)} placeholder="Any price"/></label><label>Pickup area<input value={loc} onChange={e=>set('location',e.target.value)} placeholder="Any area"/></label></div><div className="results-head"><strong>{shown.length} items</strong><span>Sample listings are marked</span></div>{loading?<p>Loading listings…</p>:shown.length?<div className="items-grid">{shown.map(card)}</div>:<div className="empty"><h3>No items found</h3><p>Try a different search or remove some filters.</p><button className="btn secondary" onClick={()=>setParams({})}>Clear filters</button></div>}</main>}
function Details(){const{id}=useParams();const item=[...items,...demos].find(i=>i.id===id);const[start,setStart]=useState(''),[end,setEnd]=useState(''),[note,setNote]=useState(''),[busy,setBusy]=useState(false),[msg,setMsg]=useState('');if(!item)return <main className="container page"><h1>Item not found</h1><Link to="/explore">Back to explore</Link></main>;const days=start&&end?dayCount(start,end):0;const valid=!!start&&!!end&&end>=start&&start>=today();const subtotal=days*item.price,fee=Math.round(subtotal*feeRate),total=subtotal+fee+item.deposit;async function request(){if(!user){nav('/auth');return}if(!valid||item.demo||!db)return;setBusy(true);const{error}=await db.from('rental_requests').insert({item_id:item.id,renter_id:user.id,start_date:start,end_date:end,note:note.trim(),daily_price:item.price,deposit:item.deposit,service_fee:fee});setMsg(error?error.message:'Request sent. You can track its status in My requests.');setBusy(false)}return <main className="container page"><Link className="back" to="/explore">← Back to rentals</Link><div className="detail-layout"><div><div className="detail-image"><img src={item.image_url} alt={item.title}/>{item.demo&&<span className="image-label">SAMPLE LISTING — NOT BOOKABLE</span>}</div><p className="eyebrow">{item.category} · {item.condition} condition</p><h1>{item.title}</h1><p className="muted"><MapPin size={17}/> {item.location}, Dumaguete area (approximate)</p><h3>About this item</h3><p>{item.description}</p><h3>Rental details</h3><p>Discuss exact pickup location, handover, condition photos, and return expectations with the owner before exchanging an item or money.</p></div><aside className="booking"><p className="price-large">{peso(item.price)} <small>/ day</small></p>{item.demo?<p className="notice">This is a demonstration item. It has no real owner or availability and cannot be requested.</p>:<><label>Start date<input type="date" min={today()} value={start} onChange={e=>setStart(e.target.value)}/></label><label>Return date<input type="date" min={start||today()} value={end} onChange={e=>setEnd(e.target.value)}/></label><label>Message to owner<textarea value={note} onChange={e=>setNote(e.target.value)} placeholder="Tell the owner what you need it for"/></label></>}{valid&&<div className="breakdown"><div><span>Rental ({days} days)</span><strong>{peso(subtotal)}</strong></div><div><span>Proposed service fee (8%, not collected online)</span><strong>{peso(fee)}</strong></div><div><span>Refundable deposit</span><strong>{peso(item.deposit)}</strong></div><div className="total"><span>Estimated total</span><strong>{peso(total)}</strong></div></div>}<p className="small muted">Payment arranged directly with owner. No online payment or payment protection is provided.</p>{!item.demo&&<button disabled={busy||!valid||item.owner_id===user?.id} className="btn primary full" onClick={request}>{busy?'Sending…':'Request to borrow'} <ArrowRight size={17}/></button>}{msg&&<p role="status" className="notice">{msg}</p>}</aside></div></main>}
function Auth(){const[email,setEmail]=useState(''),[password,setPassword]=useState(''),[signup,setSignup]=useState(false),[msg,setMsg]=useState(''),[busy,setBusy]=useState(false);async function submit(e:React.FormEvent){e.preventDefault();if(!db){setMsg('Connect Supabase first using the setup instructions.');return}setBusy(true);const{error}=signup?await db.auth.signUp({email,password}):await db.auth.signInWithPassword({email,password});setMsg(error?error.message:signup?'Account created. Check your email if confirmation is enabled.':'Signed in successfully.');setBusy(false);if(!error&&!signup)nav('/requests')}return <main className="container page auth"><p className="eyebrow">WELCOME TO DUMABORROW</p><h1>{signup?'Make an account.':'Welcome back.'}</h1><p className="muted">{signup?'Join the neighborhood sharing community.':'Sign in to manage your items and requests.'}</p><form onSubmit={submit} className="form"><label>Email<input type="email" required value={email} onChange={e=>setEmail(e.target.value)} autoComplete="email"/></label><label>Password<input type="password" required minLength={6} value={password} onChange={e=>setPassword(e.target.value)} autoComplete={signup?'new-password':'current-password'}/></label><button className="btn primary full" disabled={busy}>{busy?'Please wait…':signup?'Create account':'Sign in'}</button></form><p role="status">{msg}</p><button className="link-button" onClick={()=>{setSignup(!signup);setMsg('')}}>{signup?'Already have an account? Sign in':'New here? Create an account'}</button>{!configured&&<p className="notice">Live accounts require Supabase configuration. See README.</p>}</main>}
const blank={title:'',category:'Calculators',description:'',price:'',location:'',condition:'Good',deposit:'0',image_url:'',available_from:'',available_until:'',status:'published'};
function ListingForm(){const{id}=useParams();const[form,setForm]=useState({...blank}),[msg,setMsg]=useState(''),[busy,setBusy]=useState(false),[uploading,setUploading]=useState(false);useEffect(()=>{if(id&&db&&user)db.from('items').select('*').eq('id',id).eq('owner_id',user.id).single().then(({data})=>{if(data)setForm({title:data.title,category:data.category,description:data.description,price:String(data.price),location:data.location,condition:data.condition,deposit:String(data.deposit),image_url:data.image_url,available_from:data.available_from||'',available_until:data.available_until||'',status:data.status})})},[id,user?.id]);const change=(key:string,value:string)=>setForm(f=>({...f,[key]:value}));async function upload(file:File){if(!db||!user){setMsg('Sign in and configure Supabase first.');return}if(!['image/jpeg','image/png','image/webp'].includes(file.type)||file.size>5_000_000){setMsg('Use JPG, PNG, or WebP under 5 MB.');return}setUploading(true);const path=user.id+'/'+crypto.randomUUID()+'-'+file.name.replace(/[^a-zA-Z0-9.-]/g,'');const{error}=await db.storage.from('item-photos').upload(path,file,{upsert:false});if(error)setMsg(error.message);else{const{data}=db.storage.from('item-photos').getPublicUrl(path);change('image_url',data.publicUrl)}setUploading(false)}async function submit(e:React.FormEvent){e.preventDefault();if(!db||!user){nav('/auth');return}if(!form.image_url){setMsg('Upload an item photograph.');return}setBusy(true);const record={title:form.title.trim(),category:form.category,description:form.description.trim(),price:Number(form.price),location:form.location.trim(),condition:form.condition,deposit:Number(form.deposit),image_url:form.image_url,available_from:form.available_from||null,available_until:form.available_until||null,status:form.status};const res=id?await db.from('items').update(record).eq('id',id).eq('owner_id',user.id):await db.from('items').insert({...record,owner_id:user.id});setBusy(false);if(res.error)setMsg(res.error.message);else{await refresh();nav('/my-listings')}}return <main className="container page form-page"><p className="eyebrow">SHARE SOMETHING USEFUL</p><h1>{id?'Edit your listing':'List an item for free.'}</h1><p className="muted">Good photos and clear details help borrowers decide. Only list items you own or are authorized to rent.</p><form className="form" onSubmit={submit}><label>Item title<input required maxLength={100} value={form.title} onChange={e=>change('title',e.target.value)} placeholder="e.g. Scientific calculator"/></label><label>Category<select value={form.category} onChange={e=>change('category',e.target.value)}>{categories.map(c=><option key={c}>{c}</option>)}</select></label><label>Description<textarea required minLength={15} maxLength={2000} rows={5} value={form.description} onChange={e=>change('description',e.target.value)} placeholder="What's included? Any marks, limitations, or usage rules?"/></label><div className="form-two"><label>Price per day (PHP)<input required type="number" min="1" max="100000" step="1" value={form.price} onChange={e=>change('price',e.target.value)}/></label><label>Refundable deposit (PHP)<input required type="number" min="0" max="1000000" step="1" value={form.deposit} onChange={e=>change('deposit',e.target.value)}/></label></div><div className="form-two"><label>Approximate pickup area<input required maxLength={100} value={form.location} onChange={e=>change('location',e.target.value)} placeholder="e.g. Piapi"/></label><label>Condition<select value={form.condition} onChange={e=>change('condition',e.target.value)}>{['New','Excellent','Good','Fair'].map(c=><option key={c}>{c}</option>)}</select></label></div><div className="form-two"><label>Available from (optional)<input type="date" value={form.available_from} onChange={e=>change('available_from',e.target.value)}/></label><label>Available until (optional)<input type="date" min={form.available_from} value={form.available_until} onChange={e=>change('available_until',e.target.value)}/></label></div><label>Item photograph (max 5 MB)<input type="file" accept="image/jpeg,image/png,image/webp" onChange={e=>e.target.files?.[0]&&upload(e.target.files[0])}/></label>{uploading&&<p>Uploading photograph…</p>}{form.image_url&&<img className="upload-preview" src={form.image_url} alt="Listing photo preview"/>}<label>Visibility<select value={form.status} onChange={e=>change('status',e.target.value)}><option value="published">Published</option><option value="paused">Paused</option></select></label><button disabled={busy||uploading} className="btn primary full">{busy?'Saving…':id?'Save changes':'Publish listing'}</button><p role="status">{msg}</p></form></main>}
function MyListings(){const[own,setOwn]=useState<Item[]>([]),[requests,setRequests]=useState<any[]>([]),[msg,setMsg]=useState('');async function load(){if(!db||!user)return;const{data}=await db.from('items').select('*').eq('owner_id',user.id).order('created_at',{ascending:false});setOwn(data||[]);const{data:r}=await db.from('rental_requests').select('*,items!inner(title,owner_id)').eq('items.owner_id',user.id).order('created_at',{ascending:false});setRequests(r||[])}useEffect(()=>{load()},[user?.id]);async function updateItem(i:Item,status:string){if(!db||!window.confirm(status==='removed'?'Remove this listing?':'Change listing visibility?'))return;const{error}=await db.from('items').update({status}).eq('id',i.id);setMsg(error?.message||'Listing updated');load();refresh()}async function decide(id:string,status:string){if(!db)return;const{error}=await db.rpc('decide_request',{p_request_id:id,p_decision:status});setMsg(error?.message||'Request updated');load()}return <main className="container page"><p className="eyebrow">YOUR SPACE</p><h1>My listings</h1>{!user?<LoginNeeded/>:<><Link className="btn primary" to="/list">Add a listing <ArrowUpRight size={17}/></Link><p role="status">{msg}</p><div className="dashboard-list">{own.length===0?<div className="empty">No listings yet. Start by sharing something useful.</div>:own.map(i=><div className="dashboard-row" key={i.id}><img src={i.image_url} alt=""/><div><h3>{i.title}</h3><p>{peso(i.price)} / day · {i.status}</p></div><div className="row-actions"><Link to={'/edit/'+i.id}>Edit</Link><button onClick={()=>updateItem(i,i.status==='published'?'paused':'published')}>{i.status==='published'?'Pause':'Publish'}</button><button onClick={()=>updateItem(i,'removed')}>Remove</button></div></div>)}</div><h2>Incoming rental requests</h2><div className="dashboard-list">{requests.length===0?<p>No requests yet.</p>:requests.map(r=><div className="request-row" key={r.id}><div><strong>{r.items?.title}</strong><p>{r.start_date} to {r.end_date} · {r.status}</p><p>Message: {r.note||'None'}</p></div>{r.status==='pending'&&<div className="row-actions"><button onClick={()=>decide(r.id,'accepted')}>Accept</button><button onClick={()=>decide(r.id,'declined')}>Decline</button></div>}</div>)}</div></>}</main>}
function Requests(){const[requests,setRequests]=useState<any[]>([]);useEffect(()=>{if(db&&user)db.from('rental_requests').select('*,items(title,location)').eq('renter_id',user.id).order('created_at',{ascending:false}).then(({data})=>setRequests(data||[]))},[user?.id]);return <main className="container page"><p className="eyebrow">KEEP TRACK</p><h1>My rental requests</h1>{!user?<LoginNeeded/>:requests.length===0?<div className="empty"><h3>No requests yet.</h3><p>Find something useful and request dates from the owner.</p><Link className="btn primary" to="/explore">Explore rentals</Link></div>:<div className="dashboard-list">{requests.map(r=><div className="request-row" key={r.id}><div><h3>{r.items?.title}</h3><p>{r.start_date} — {r.end_date}</p><p>Status: <strong>{r.status}</strong> · Payment: Arranged directly with owner</p><p>Estimated total: {peso(dayCount(r.start_date,r.end_date)*r.daily_price+r.service_fee+r.deposit)}</p></div></div>)}</div>}</main>}
function LoginNeeded(){return <div className="empty"><p>Please sign in to use this page.</p><Link className="btn primary" to="/auth">Sign in</Link></div>}
function Account(){const[msg,setMsg]=useState('');return <main className="container page"><p className="eyebrow">YOUR ACCOUNT</p><h1>Account settings</h1>{!user?<LoginNeeded/>:<div className="form"><p>Signed in as <strong>{user.email}</strong></p><button className="btn secondary" onClick={async()=>{const{error}=await db!.auth.resetPasswordForEmail(user.email,{redirectTo:window.location.origin+'/account'});setMsg(error?.message||'Password reset email requested.')}}>Send password reset email</button><button className="btn primary" onClick={logout}>Log out</button><p role="status">{msg}</p></div>}</main>}
const faqs=[['Is DumaBorrow free to join?','Yes. Registration and basic listings are free. A proposed 8% service fee is shown in estimates but is not currently collected by the platform.'],['Can I book a sample item?','No. Sample listings demonstrate the experience and are not real offers. Only member-published items can receive requests.'],['How do payments work?','The initial version does not collect online payments. Renters and owners arrange payment directly. DumaBorrow does not verify payment or provide escrow.'],['What if an item is damaged?','Discuss item condition, deposit, and responsibility before handover. Take photos together and document agreements. The platform does not currently provide insurance or dispute resolution.'],['How do I stay safe?','Meet in a public, well-lit location, avoid sharing sensitive information, inspect the item, and do not pay in advance to someone you cannot verify.'],['Can owners decline requests?','Yes. A request stays pending until an owner accepts or declines it.']];
function Info({type}:{type:string}){const title:Record<string,string>={about:'About DumaBorrow',contact:'Contact us',faq:'Frequently asked questions',terms:'Terms of use',privacy:'Privacy policy',guidelines:'Rental guidelines'};return <main className="container page info"><p className="eyebrow">DUMABORROW</p><h1>{title[type]}</h1>{type==='about'?<><p>DumaBorrow is a community item-rental marketplace concept designed for students and local residents in Dumaguete City, Negros Oriental.</p><p>Our aim is simple: make occasional-use items easier to access, and help owners put their unused belongings to work.</p></>:type==='contact'?<><p>For questions or reports, contact the site operator through the contact address published by the operator. A support inbox has not yet been configured.</p><p className="notice">Before launch, add a real support email and an operational process for handling reports.</p></>:type==='faq'?faqs.map(([q,a])=><details key={q}><summary>{q}<ChevronDown size={18}/></summary><p>{a}</p></details>):type==='terms'?<><p><strong>Draft terms — review before public launch.</strong> DumaBorrow facilitates rental requests between users. Listings and agreements are the responsibility of their participants. Users must provide accurate information, have the right to rent listed items, and follow applicable law.</p><p>Requests do not guarantee a rental. Owners can accept or decline. Online payments are not supported. The proposed platform fee is informational only and is not collected. Prohibited listings include illegal, dangerous, counterfeit, or stolen goods.</p><p>Operators may remove listings that violate rules. These draft terms do not replace legal review.</p></>:type==='privacy'?<><p><strong>Draft privacy notice — review before public launch.</strong> Supabase stores account email addresses, authentication data, item listings, uploaded photographs, and rental requests. These are used to operate accounts, display listings, and coordinate requests.</p><p>Published listing descriptions, approximate areas, and photographs are visible to visitors. Do not upload personal IDs or sensitive information. Authentication and data storage are provided by Supabase subject to the operator's configuration.</p><p>Before public launch, publish the operator's identity, contact, retention/deletion policy, legal basis for processing, and applicable Philippine Data Privacy Act disclosures.</p></>:<><p>Photograph the item honestly, disclose defects, and agree on dates, price, deposit, meetup place, and return conditions in writing.</p><p>Meet in public during daylight where possible. Inspect items at handover and return. Never post sensitive personal information in listing descriptions. Report suspicious listings to the operator.</p><p>Payment is arranged directly with the owner; the platform does not hold funds, guarantee payment, insure items, or verify users.</p></>}</main>}
function Admin(){const[reports,setReports]=useState<any[]>([]),[msg,setMsg]=useState('');async function load(){if(db){const{data,error}=await db.from('reports').select('*,items(title)').order('created_at',{ascending:false});if(error)setMsg('Admin access required.');else setReports(data||[])}}useEffect(()=>{load()},[]);async function moderate(r:any){if(!db)return;const{error}=await db.rpc('moderate_report',{p_report_id:r.id});setMsg(error?.message||'Listing hidden and report resolved.');load();refresh()}return <main className="container page"><p className="eyebrow">MODERATION</p><h1>Reported listings</h1><p>Only designated administrators can access reports.</p><p role="status">{msg}</p><div className="dashboard-list">{reports.map(r=><div className="request-row" key={r.id}><div><strong>{r.items?.title||'Listing'}</strong><p>{r.reason}</p><p>{r.status}</p></div>{r.status==='open'&&<button className="btn secondary" onClick={()=>moderate(r)}>Hide listing & resolve</button>}</div>)}</div></main>}
function Report({itemId}:{itemId:string}){const[reason,setReason]=useState(''),[msg,setMsg]=useState('');async function send(){if(!user){setMsg('Sign in to report a listing.');return}if(!db)return;const{error}=await db.from('reports').insert({item_id:itemId,reporter_id:user.id,reason});setMsg(error?.message||'Report submitted for review.');if(!error)setReason('')}return <div className="report"><h3>Something wrong with this listing?</h3><label>Reason for report<textarea maxLength={500} value={reason} onChange={e=>setReason(e.target.value)} placeholder="Describe the concern"/></label><button className="btn secondary" disabled={reason.trim().length<10} onClick={send}>Submit report</button><p role="status">{msg}</p></div>}
function DetailPage(){const{id}=useParams();const item=items.find(i=>i.id===id);return <><Details/>{item&&<div className="container"><Report itemId={item.id}/></div>}</>}
return <><header className="site-header"><div className="container nav"><Link to="/" className="logo" onClick={()=>setMenu(false)}><span className="logo-mark">d<span>.</span></span><span>DumaBorrow</span></Link><nav className={menu?'nav-links open':'nav-links'} aria-label="Main navigation"><NavLink to="/explore" onClick={()=>setMenu(false)}>Explore</NavLink><Link to="/#how" onClick={()=>{setMenu(false);setTimeout(()=>document.querySelector('.steps')?.scrollIntoView({behavior:'smooth'}),50)}}>How it works</Link><NavLink to="/list" onClick={()=>setMenu(false)}>List an item</NavLink>{user&&<><NavLink to="/my-listings" onClick={()=>setMenu(false)}>My listings</NavLink><NavLink to="/requests" onClick={()=>setMenu(false)}>My requests</NavLink><NavLink to="/account" onClick={()=>setMenu(false)}>Account</NavLink></>}<Link className="nav-sign" to={user?'/account':'/auth'} onClick={()=>setMenu(false)}>{user?'My account':'Sign in'} <ArrowUpRight size={15}/></Link></nav><button className="menu-button" aria-label={menu?'Close menu':'Open menu'} aria-expanded={menu} onClick={()=>setMenu(!menu)}>{menu?<X/>:<Menu/>}</button></div></header><Routes><Route path="/" element={<Home/>}/><Route path="/explore" element={<Explore/>}/><Route path="/item/:id" element={<DetailPage/>}/><Route path="/auth" element={<Auth/>}/><Route path="/list" element={user?<ListingForm/>:<main className="container page"><h1>List an item</h1><LoginNeeded/></main>}/><Route path="/edit/:id" element={user?<ListingForm/>:<LoginNeeded/>}/><Route path="/my-listings" element={<MyListings/>}/><Route path="/requests" element={<Requests/>}/><Route path="/account" element={<Account/>}/>{['about','contact','faq','terms','privacy','guidelines'].map(type=><Route key={type} path={'/'+type} element={<Info type={type}/>}/>) }<Route path="/admin" element={<Admin/>}/><Route path="*" element={<main className="container page"><h1>Page not found</h1><Link to="/">Go home</Link></main>}/></Routes><footer className="footer"><div className="container footer-top"><div><Link to="/" className="logo"><span className="logo-mark">d<span>.</span></span>DumaBorrow</Link><p>The things you need,<br/>from people nearby.</p></div><div><h4>Discover</h4><Link to="/explore">Explore rentals</Link><Link to="/list">List an item</Link><Link to="/faq">Help & FAQ</Link></div><div><h4>Company</h4><Link to="/about">About</Link><Link to="/contact">Contact</Link><Link to="/guidelines">Rental guidelines</Link></div><div><h4>Legal</h4><Link to="/terms">Terms</Link><Link to="/privacy">Privacy</Link></div></div><div className="container footer-bottom"><span>© {new Date().getFullYear()} DumaBorrow. Built for Dumaguete.</span><span>Borrow more. Spend less.</span></div></footer></>}
createRoot(document.getElementById('root')!).render(<BrowserRouter><App/></BrowserRouter>);
